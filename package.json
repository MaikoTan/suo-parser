{
  "name": "suo-parser",
  "version": "0.3.0",
  "description": "A timeline parser for FFXIV/ACT plugins",
  "main": "pkg/suo_parser_wasm.js",
  "types": "pkg/suo_parser_wasm.d.ts",
  "bin": {
    "suo-parser": "bin/suo.js"
  },
  "author": {
    "name": "Maiko Tan",
    "email": "maiko.tan.coding@gmail.com",
    "url": "https://github.com/MaikoTan"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MaikoTan/suo-parser"
  },
  "license": "MIT",
  "keywords": [
    "ffxiv",
    "act",
    "timeline",
    "parser",
    "wasm"
  ],
  "files": [
    "pkg/",
    "bin/"
  ],
  "scripts": {
    "build": "wasm-pack build wasm --target nodejs --out-dir ../pkg && rm -f pkg/.gitignore",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=12.0.0"
  }
